    "visual": "node scripts/visual.js",
    "release": "npx npmpub"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "postcss": "^8.5.0",
    "source-map": "^0.7.4"
  },
  "peerDependencies": {
    "postcss": "^8.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
