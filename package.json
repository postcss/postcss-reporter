{
  "name": "postcss-reporter",
  "version": "7.1.0",
  "description": "Log PostCSS messages in the console",
  "keywords": [
    "css",
    "postcss",
    "postcss-plugin",
    "reporter",
    "warnings"
  ],
  "homepage": "https://github.com/postcss/postcss-reporter",
  "license": "MIT",
  "author": "MoOx",
  "contributors": [
    {
      "name": "David Clark",
      "email": "david.dave.clark@gmail.com",
      "url": "https://davidtheclark.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/postcss/postcss-reporter.git"
  },
  "files": [
    "LICENSE",
    "index.js",
    "lib/formatter.js",
    "lib/reporter.js",
    "lib/util.js"
  ],
  "main": "index.js",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "unit": "node --test",
